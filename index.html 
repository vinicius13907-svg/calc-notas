<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>Calc &amp; Notas iOS</title>

  <!-- Meta Tags para PWA e Modo Aplicativo Nativo -->
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="Calc &amp; Notas">
  <meta name="application-name" content="Calc &amp; Notas">
  <meta name="theme-color" content="#f2f2f7" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)">

  <!-- Manifest de Aplicativo Embutido (Gera o Ícone na Tela Inicial) -->
  <link rel="manifest" href='data:application/manifest+json,{"name":"Calc %26 Notas iOS","short_name":"Calc %26 Notas","start_url":".","display":"standalone","background_color":"#000000","theme_color":"#ff9f0a","icons":[{"src":"data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 512 512%22%3E%3Crect width=%22512%22 height=%22512%22 rx=%22100%22 fill=%22%231c1c1e%22/%3E%3Cpath d=%22M160 120h192v272H160z%22 fill=%22none%22 stroke=%22%23ff9f0a%22 stroke-width=%2224%22/%3E%3Ctext x=%22256%22 y=%22295%22 font-size=%22160%22 fill=%22%23ff9f0a%22 text-anchor=%22middle%22 font-family=%22sans-serif%22 font-weight=%22bold%22%3E%3D%3C/text%3E%3C/svg%3E","sizes":"512x512","type":"image/svg+xml"}]}'>

  <style>
    :root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
    html{scroll-padding-top:env(safe-area-inset-top,0px)}
    body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}
    img{max-width:100%}
    [hidden]:not([hidden=until-found i]){display:none!important}

    /* Layout: uma tela só. No celular, duas abas (Calculadora e Notas). Em tela larga, as duas lado a lado. */
    :root{
      --bg:#f2f2f7; --surface:#ffffff; --surface-2:#e8e8ed; --line:#d9d9df;
      --fg:#121216; --muted:#6a6a75;
      --accent:#ff9500; --on-accent:#1c1200; --accent-text:#9c5400; --chip-bg:#ffefd6;
      --key-num:#ffffff; --key-num-ink:#121216; --key-fn:#d2d2d8; --key-fn-ink:#121216;
      --op-on-bg:#ffffff; --op-on-ink:#9c5400;
      --danger:#c4291f;
      --font-ui:-apple-system,BlinkMacSystemFont,"SF Pro Text","Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;
      --font-num:-apple-system,BlinkMacSystemFont,"SF Pro Display","Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;
    }
    @media (prefers-color-scheme: dark){
      :root:not([data-theme="light"]){
        --bg:#000000; --surface:#1c1c1e; --surface-2:#2a2a2d; --line:#303034;
        --fg:#f5f5f7; --muted:#8e8e93;
        --accent:#ff9f0a; --on-accent:#1c1200; --accent-text:#ffb340; --chip-bg:#3b2a0a;
        --key-num:#333336; --key-num-ink:#f5f5f7; --key-fn:#a5a5a8; --key-fn-ink:#0b0b0c;
        --op-on-bg:#f5f5f7; --op-on-ink:#9c5400;
        --danger:#ff6b61;
        color-scheme:dark;
      }
    }
    :root[data-theme="dark"]{
      --bg:#000000; --surface:#1c1c1e; --surface-2:#2a2a2d; --line:#303034;
      --fg:#f5f5f7; --muted:#8e8e93;
      --accent:#ff9f0a; --on-accent:#1c1200; --accent-text:#ffb340; --chip-bg:#3b2a0a;
      --key-num:#333336; --key-num-ink:#f5f5f7; --key-fn:#a5a5a8; --key-fn-ink:#0b0b0c;
      --op-on-bg:#f5f5f7; --op-on-ink:#9c5400;
      --danger:#ff6b61;
      color-scheme:dark;
    }

    *{box-sizing:border-box}
    html,body{height:100%}
    body{
      margin:0; background:var(--bg); color:var(--fg);
      font-family:var(--font-ui); font-size:14px; line-height:1.4;
      -webkit-font-smoothing:antialiased; -webkit-tap-highlight-color:transparent;
      padding-left:max(16px, env(safe-area-inset-left, 0px));
      padding-right:max(16px, env(safe-area-inset-right, 0px));
      padding-block:12px;
    }
    button,input{font:inherit;color:inherit}
    button{cursor:pointer}
    :focus-visible{outline:2px solid var(--accent-text); outline-offset:2px}

    .app{height:100%; max-width:440px; margin:0 auto; display:flex; flex-direction:column; gap:12px; min-height:0}

    /* Abas */
    .tabs{flex:none; display:grid; grid-template-columns:1fr 1fr; gap:4px; padding:4px; background:var(--surface-2); border-radius:14px}
    .tab{display:flex; align-items:center; justify-content:center; gap:7px; padding:10px 8px; border:0; border-radius:10px; background:transparent; color:var(--muted); font-weight:600; font-size:13px; line-height:1; transition:background .15s,color .15s}
    .tab.is-active{background:var(--accent); color:var(--on-accent)}
    .badge{min-width:18px; padding:2px 6px; border-radius:99px; background:var(--fg); color:var(--bg); font-size:11px; font-weight:700; text-align:center}

    .panels{flex:1; min-height:0; display:flex}
    .panel{flex:1; min-width:0; min-height:0; display:none; flex-direction:column; position:relative}
    .panel.is-active{display:flex}

    svg.ic{width:16px; height:16px; flex:none; fill:none; stroke:currentColor; stroke-width:2; stroke-linecap:round; stroke-linejoin:round}

    /* Calculadora */
    .calc-scroll{flex:1; min-height:0; overflow-y:auto; display:flex; flex-direction:column}
    .calc-top{margin-top:auto; display:flex; align-items:center; gap:6px; padding:0 2px}
    .icon-btn{width:34px; height:34px; flex:none; display:grid; place-items:center; border:0; border-radius:10px; background:var(--surface-2); color:var(--muted)}
    .icon-btn:active{opacity:.7}
    .chip-toggle{height:34px; padding:0 11px; flex:none; border:1px solid var(--line); border-radius:10px; background:transparent; color:var(--muted); font-weight:700; font-size:13px}
    .chip-toggle[aria-pressed="true"]{background:var(--chip-bg); color:var(--accent-text); border-color:transparent}
    .expr{flex:1; min-width:0; margin:0; text-align:right; color:var(--muted); font-size:15px; font-variant-numeric:tabular-nums; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; min-height:21px}
    .value{margin:4px 2px 10px; text-align:right; font-family:var(--font-num); font-weight:300; font-size:64px; line-height:1.1; letter-spacing:-.02em; white-space:nowrap; overflow:hidden; font-variant-numeric:tabular-nums}

    .send-row{display:flex; gap:8px; margin-bottom:12px}
    .field{flex:1; min-width:0; padding:10px 12px; border:1px solid var(--line); border-radius:12px; background:var(--surface); font-size:16px}
    .field::placeholder{color:var(--muted)}
    .field:focus{outline:2px solid var(--accent-text); outline-offset:0; border-color:transparent}
    .btn{flex:none; display:inline-flex; align-items:center; justify-content:center; gap:6px; padding:10px 14px; border:0; border-radius:12px; background:var(--accent); color:var(--on-accent); font-weight:700; font-size:14px; white-space:nowrap}
    .btn:active{opacity:.8}
    .btn-soft{background:var(--chip-bg); color:var(--accent-text)}

    .keypad{width:100%; max-width:360px; margin:0 auto 4px; display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:10px}
    .key{aspect-ratio:1; border:0; border-radius:50%; font-family:var(--font-num); font-size:clamp(22px,7vw,30px); font-weight:400; display:flex; align-items:center; justify-content:center; user-select:none; -webkit-user-select:none; transition:filter .12s}
    .key:active{filter:brightness(1.25)}
    .k-num{background:var(--key-num); color:var(--key-num-ink); box-shadow:0 1px 0 var(--line)}
    .k-fn{background:var(--key-fn); color:var(--key-fn-ink); font-size:clamp(20px,6vw,26px); font-weight:500}
    .k-op{background:var(--accent); color:var(--on-accent); font-weight:500; font-size:clamp(26px,8vw,34px)}
    .k-op.is-active{background:var(--op-on-bg); color:var(--op-on-ink); box-shadow:inset 0 0 0 3px var(--accent)}
    .k-zero{grid-column:span 2; aspect-ratio:auto; align-self:stretch; justify-content:flex-start; padding-left:8%; border-radius:999px}

    /* Histórico */
    .sheet{position:absolute; inset:0; z-index:5; background:var(--bg); display:flex; flex-direction:column; gap:10px}
    .sheet-head{display:flex; align-items:center; gap:8px}
    .sheet-head h2{margin:0; flex:1; font-size:17px; font-weight:700}
    .link-btn{border:0; background:none; padding:6px 4px; color:var(--accent-text); font-weight:600; font-size:13px}
    .link-btn.danger{color:var(--danger)}
    .list{list-style:none; margin:0; padding:0; flex:1; min-height:0; overflow-y:auto; display:flex; flex-direction:column; gap:8px}
    .hist{display:flex; flex-direction:column; gap:8px; padding:12px 14px; background:var(--surface); border:1px solid var(--line); border-radius:14px}
    .hist-line{display:flex; justify-content:space-between; gap:10px; align-items:baseline; min-width:0}
    .hist-expr{min-width:0; color:var(--muted); font-variant-numeric:tabular-nums; overflow-wrap:anywhere}
    .hist-res{font-size:20px; font-weight:600; font-variant-numeric:tabular-nums; white-space:nowrap}
    .hist-actions{display:flex; gap:12px}
    .empty{padding:36px 12px; text-align:center; color:var(--muted)}

    /* Notas */
    .summary{flex:none; display:grid; grid-template-columns:1fr 1fr; gap:8px}
    .sum{display:flex; flex-direction:column; align-items:flex-start; gap:2px; padding:12px 14px; border:1px solid var(--line); border-radius:14px; background:var(--surface); text-align:left}
    .sum:active{opacity:.75}
    .sum-label{font-size:11px; font-weight:700; letter-spacing:.06em; text-transform:uppercase; color:var(--muted)}
    .sum-value{font-family:var(--font-num); font-size:22px; font-weight:600; font-variant-numeric:tabular-nums; max-width:100%; overflow-wrap:anywhere}
    .sum.pending .sum-value{color:var(--accent-text)}
    .hint{flex:none; margin:10px 2px; color:var(--muted); font-size:12.5px}
    .add-row{flex:none; display:flex; gap:8px}
    .pull{flex:none; align-self:flex-start; margin:4px 0 8px}
    .notes{margin-top:2px}
    .note{display:flex; align-items:flex-start; gap:4px; padding:4px 4px 4px 2px; background:var(--surface); border:1px solid var(--line); border-radius:14px}
    .check,.del{width:38px; height:38px; flex:none; display:grid; place-items:center; border:0; background:none}
    .ring{width:22px; height:22px; border-radius:50%; border:2px solid var(--muted); display:grid; place-items:center; color:var(--on-accent); transition:background .15s,border-color .15s}
    .ring svg{width:12px; height:12px; stroke-width:3; opacity:0}
    .note.is-done .ring{background:var(--accent); border-color:var(--accent)}
    .note.is-done .ring svg{opacity:1}
    .note-text{flex:1; min-width:0; padding:9px 0; font-size:15px; font-weight:500; overflow-wrap:anywhere; cursor:pointer}
    .note.is-done .note-text{color:var(--muted); text-decoration:line-through}
    .chip{display:inline; margin:0 1px; padding:1px 8px; border:0; border-radius:99px; background:var(--chip-bg); color:var(--accent-text); font-weight:700; font-size:14px; font-variant-numeric:tabular-nums; text-decoration:none}
    .chip:active{opacity:.7}
    .del{color:var(--muted)}
    .del:hover{color:var(--danger)}
    .foot{flex:none; display:flex; justify-content:space-between; align-items:center; gap:10px; padding-top:10px; margin-top:8px; border-top:1px solid var(--line); color:var(--muted); font-size:12.5px; min-height:44px}
    .confirm{display:flex; align-items:center; gap:10px; flex-wrap:wrap; justify-content:flex-end}

    .toast{position:fixed; left:50%; bottom:calc(20px + env(safe-area-inset-bottom, 0px)); transform:translate(-50%,8px); max-width:calc(100vw - 32px); padding:10px 16px; border-radius:99px; background:var(--fg); color:var(--bg); font-weight:600; font-size:13px; opacity:0; pointer-events:none; transition:opacity .2s,transform .2s; z-index:20; text-align:center}
    .toast.show{opacity:1; transform:translate(-50%,0)}

    @media (min-width:880px){
      .app{max-width:980px}
      .tabs{display:none}
      .panels{display:grid; grid-template-columns:minmax(0,380px) minmax(0,1fr); gap:32px}
      .panel{display:flex}
      .panel + .panel{border-left:1px solid var(--line); padding-left:32px}
    }
    @media (prefers-reduced-motion:reduce){
      *{transition:none!important; animation:none!important}
    }
  </style>
</head>
<body>

<div class="app">
  <div class="tabs" role="tablist" aria-label="Seções">
    <button class="tab is-active" id="tabCalc" role="tab" type="button" aria-selected="true" aria-controls="calcPanel">
      <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="2.5" width="14" height="19" rx="2.5"/><path d="M8.5 7h7M8.5 12h.01M12 12h.01M15.5 12h.01M8.5 16h.01M12 16h.01M15.5 16h.01"/></svg>
      Calculadora
    </button>
    <button class="tab" id="tabNotes" role="tab" type="button" aria-selected="false" aria-controls="notesPanel">
      <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h9l4 4v14H6z"/><path d="M9 11h7M9 15h7"/></svg>
      Bloco de Notas
      <span class="badge" id="notesBadge" hidden>0</span>
    </button>
  </div>

  <main class="panels">
    <!-- Calculadora -->
    <section class="panel is-active" id="calcPanel" role="tabpanel" aria-labelledby="tabCalc">
      <div class="calc-scroll">
        <div class="calc-top">
          <button class="icon-btn" id="histBtn" type="button" aria-label="Abrir histórico">
            <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
          </button>
          <button class="icon-btn" id="backBtn" type="button" aria-label="Apagar último dígito">
            <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 5H9l-6 7 6 7h12a1 1 0 0 0 1-1V6a1 1 0 0 0-1-1z"/><path d="m13 9 4 6M17 9l-4 6"/></svg>
          </button>
          <button class="chip-toggle" id="moneyBtn" type="button" aria-pressed="true" title="Enviar valores para as notas em reais">R$</button>
          <p class="expr" id="expr"></p>
        </div>
        <p class="value" id="value" aria-label="Visor">0</p>

        <div class="send-row">
          <input class="field" id="descInput" type="text" maxlength="60" autocomplete="off" placeholder="Descrição (ex: Mercado)" aria-label="Descrição opcional da nota">
          <button class="btn" id="sendBtn" type="button">
            <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
            Enviar p/ Notas
          </button>
        </div>

        <div class="keypad" id="keypad">
          <button class="key k-fn" id="clearBtn" data-act="clear" type="button" aria-label="Limpar">AC</button>
          <button class="key k-fn" data-act="sign" type="button" aria-label="Inverter sinal">+/&minus;</button>
          <button class="key k-fn" data-act="percent" type="button" aria-label="Porcentagem">%</button>
          <button class="key k-op" data-op="÷" type="button" aria-label="Dividir">÷</button>

          <button class="key k-num" data-k="7" type="button">7</button>
          <button class="key k-num" data-k="8" type="button">8</button>
          <button class="key k-num" data-k="9" type="button">9</button>
          <button class="key k-op" data-op="×" type="button" aria-label="Multiplicar">×</button>

          <button class="key k-num" data-k="4" type="button">4</button>
          <button class="key k-num" data-k="5" type="button">5</button>
          <button class="key k-num" data-k="6" type="button">6</button>
          <button class="key k-op" data-op="-" type="button" aria-label="Subtrair">&minus;</button>

          <button class="key k-num" data-k="1" type="button">1</button>
          <button class="key k-num" data-k="2" type="button">2</button>
          <button class="key k-num" data-k="3" type="button">3</button>
          <button class="key k-op" data-op="+" type="button" aria-label="Somar">+</button>

          <button class="key k-num k-zero" data-k="0" type="button">0</button>
          <button class="key k-num" data-k="." type="button" aria-label="Vírgula">,</button>
          <button class="key k-op" data-act="equals" type="button" aria-label="Igual">=</button>
        </div>
      </div>

      <div class="sheet" id="histSheet" hidden>
        <div class="sheet-head">
          <h2>Histórico</h2>
          <button class="link-btn danger" id="histClear" type="button">Limpar</button>
          <button class="icon-btn" id="histClose" type="button" aria-label="Fechar histórico">
            <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
          </button>
        </div>
        <ul class="list" id="histList"></ul>
      </div>
    </section>

    <!-- Notas -->
    <section class="panel" id="notesPanel" role="tabpanel" aria-labelledby="tabNotes">
      <div class="summary">
        <button class="sum pending" id="sumPending" type="button">
          <span class="sum-label">Pendente</span>
          <span class="sum-value" id="sumPendingV">R$ 0,00</span>
        </button>
        <button class="sum" id="sumTotal" type="button">
          <span class="sum-label">Total</span>
          <span class="sum-value" id="sumTotalV">R$ 0,00</span>
        </button>
      </div>
      <p class="hint">Valores escritos com R$ entram na soma. Toque em um valor para levá-lo à calculadora.</p>

      <div class="add-row">
        <input class="field" id="noteInput" type="text" maxlength="120" autocomplete="off" placeholder="Ex: Aluguel R$ 1.200,00" aria-label="Nova nota">
        <button class="btn" id="addBtn" type="button">Adicionar</button>
      </div>
      <button class="link-btn pull" id="pullBtn" type="button">Trazer resultado da calculadora</button>

      <ul class="list notes" id="notesList"></ul>

      <div class="foot">
        <span id="notesCount">0 itens salvos</span>
        <button class="link-btn danger" id="clearAll" type="button">Limpar tudo</button>
        <span class="confirm" id="clearConfirm" hidden>
          Apagar todas as notas?
          <button class="link-btn danger" id="clearYes" type="button">Apagar</button>
          <button class="link-btn" id="clearNo" type="button">Cancelar</button>
        </span>
      </div>
    </section>
  </main>
</div>

<div class="toast" id="toast" role="status" aria-live="polite"></div>

<script>
(function () {
  'use strict';

  var $ = function (id) { return document.getElementById(id); };

  /* ---------- Armazenamento Local ---------- */
  function lsGet(key, fallback) {
    try { var v = localStorage.getItem(key); return v === null ? fallback : JSON.parse(v); }
    catch (e) { return fallback; }
  }
  function lsSet(key, val) {
    try { localStorage.setItem(key, JSON.stringify(val)); } catch (e) {}
  }

  /* ---------- Formatação pt-BR ---------- */
  var nfNum = new Intl.NumberFormat('pt-BR', { maximumFractionDigits: 10 });
  var nfMoney = new Intl.NumberFormat('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  function fmtNum(n) { return nfNum.format(n); }
  function fmtMoney(n) { return (n < 0 ? '-' : '') + 'R$ ' + nfMoney.format(Math.abs(n)); }
  function showOp(o) { return o === '-' ? '−' : o; }

  function fmtTyping(s) {
    if (s === 'Erro') return s;
    if (/e/i.test(s)) return s.replace('.', ',');
    var neg = s.charAt(0) === '-';
    if (neg) s = s.slice(1);
    var parts = s.split('.');
    var grouped = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, '.');
    return (neg ? '-' : '') + grouped + (parts.length > 1 ? ',' + parts[1] : '');
  }

  /* ---------- Estado ---------- */
  var S = { cur: '0', acc: null, op: null, fresh: false, ready: false, expr: '', done: false, lastExpr: '' };
  var moneyMode = lsGet('apple_calc_money', true) !== false;
  var history = lsGet('apple_calc_history', []);
  if (!Array.isArray(history)) history = [];

  var notes = lsGet('apple_integrated_notes', null);
  if (!Array.isArray(notes)) {
   